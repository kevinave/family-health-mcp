# Copy to .env and fill in. Nothing here has a default that touches your data.

# Root of the file-based health archive. The server never reads or writes
# outside this directory.
ARCHIVE_PATH=~/health-archive

# Where the two secrets live. Defaults are next to server.py.
# PATH_TOKEN_FILE=./.path_token
# TOKENS_FILE=./tokens.json

# Bind address. Keep it on loopback and put a tunnel in front of it.
# HOST=127.0.0.1
# PORT=8787

# Which member a scope="all" token falls back to when it names no one.
DEFAULT_MEMBER=alice
